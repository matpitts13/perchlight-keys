<Project Sdk="Microsoft.NET.Sdk">
  <!-- A dependency-free test runner for the C# sample: no NuGet packages, so
       "dotnet run" on this project works offline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Perchlight.Keys.Tests</RootNamespace>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PerchlightKeys/*.cs" />
  </ItemGroup>
</Project>
